# ===== 宿主机发布端口（必填，由验证环境注入；本地自测可改成 3001）=====
CC_PUBLISH_PORT=3001

# ===== PostgreSQL（仅 compose 内网，不发布到宿主）=====
DB_NAME=eldercare
DB_USER=eldercare
DB_PASSWORD=eldercare_pwd

# ===== JWT 密钥（生产部署务必修改为 >=32 字节随机串）=====
JWT_SECRET=eldercare-platform-demo-jwt-secret-key-please-change-0123456789

# compose 项目名（验证环境已通过 COMPOSE_PROJECT_NAME 固定，无需在此设置）
# COMPOSE_PROJECT_NAME=task01
